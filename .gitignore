# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments
.venv/
.env

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local editor/agent settings
.claude/settings.local.json*

# Local data — never commit fetched corpora or image caches.
# data/places.json is the exception: it is a committed lookup table, resolved
# once by `sift-pack places --refresh` (docs/decisions.md, 2026-08-07).
data/*
!data/places.json
cache/
work/
images/
*.zst
